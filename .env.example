# ==========================================
# HTTPS / Dominio (Caddy + Let's Encrypt)
# ==========================================
DOMAIN=gia.init.com.mx
# Opcional: avisos de expiración ACME (debe ser un email real, no @localhost)
# ACME_EMAIL=ops@tuempresa.com

# ==========================================
# FastAPI / Aplicación
# ==========================================
APP_NAME="Meta-Odoo Lead Gateway"
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# ==========================================
# Meta / WhatsApp / Messenger
# ==========================================
# Token de verificación del webhook (lo defines tú, debe coincidir con Meta)
META_VERIFY_TOKEN=cambiar_por_un_token_seguro_largo

# App Secret de tu app en Meta (para verificar firma X-Hub-Signature-256)
META_APP_SECRET=tu_app_secret_de_meta

# Access Token de larga duración (System User token recomendado)
META_ACCESS_TOKEN=tu_access_token_de_larga_duracion

# ID del número de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# ID de la página de Facebook (para Messenger)
MESSENGER_PAGE_ID=123456789012345

# Versión de la Graph API
META_GRAPH_VERSION=v21.0

# Token para POST /webhook/meta/lead (acciones CRM / handoff del agente)
# Cabecera: X-Meta-Lead-Token  o  query ?token=
META_LEAD_WEBHOOK_TOKEN=cambiar_por_token_lead_webhook

# ==========================================
# Odoo Enterprise (fase posterior)
# ==========================================
# Mantener false hasta conectar CRM
ODOO_ENABLED=false

ODOO_URL=https://odoo.tuempresa.com
ODOO_DB=production
ODOO_USERNAME=integrations@tuempresa.com
# Usar API Key, NO password (Odoo Enterprise lo soporta)
ODOO_API_KEY=tu_api_key_de_odoo

# Equipo de ventas por defecto (ID numérico en Odoo)
ODOO_DEFAULT_SALES_TEAM_ID=1

# Usuario por defecto al que asignar leads (ID numérico)
ODOO_DEFAULT_SALESPERSON_ID=2

# ==========================================
# Base de datos (gateway)
# ==========================================
DATABASE_URL=postgresql+asyncpg://gateway:gateway@db:5432/gateway

# ==========================================
# Scoring de leads (señal secundaria / dashboard)
# ==========================================
LEAD_CREATION_THRESHOLD=6
HUMAN_HANDOFF_THRESHOLD=9

# ==========================================
# Seguridad
# ==========================================
# Token para /admin y login del dashboard HTML
ADMIN_API_TOKEN=cambiar_por_un_token_admin_seguro

# Lista de IPs permitidas para /admin y /dashboard (separadas por coma, vacío = todas)
ADMIN_ALLOWED_IPS=

# ==========================================
# Chatwoot Agent Bot
# ==========================================
# Docs: docs/chatwoot_agent_bot.md
CHATWOOT_ENABLED=false
CHATWOOT_BASE_URL=https://chat.tuempresa.com
CHATWOOT_ACCOUNT_ID=1
# access_token del Agent Bot (Settings → Bots)
CHATWOOT_BOT_TOKEN=
# Opcional: secret para verificar firma del webhook del bot
CHATWOOT_WEBHOOK_SECRET=

# ==========================================
# LLM (OpenAI Agents SDK + LiteLLM)
# ==========================================
# OpenAI → Responses API nativa (recomendado para gpt-5.* / tools).
# Anthropic → LiteLLM. Ejemplos:
#   AGENT_MODEL=openai/gpt-5.6-luna
#   AGENT_MODEL=openai/gpt-4.1-mini
#   AGENT_MODEL=anthropic/claude-sonnet-4-20250514
AGENT_MODEL=openai/gpt-5.6-luna
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_FAQ_CHAR_LIMIT=12000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_RETRIEVE_K=8
KNOWLEDGE_UPLOADS_DIR=knowledge_uploads
