# ==========================================
# HTTPS / Dominio (Caddy + Let's Encrypt)
# ==========================================
DOMAIN=gia.init.com.mx
# Opcional: avisos de expiración ACME (debe ser un email real, no @localhost)
# ACME_EMAIL=ops@tuempresa.com

# ==========================================
# FastAPI / Aplicación
# ==========================================
APP_NAME="GIA Prospectos"
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
# Zona horaria de las fechas del dashboard (IANA). Los datos se siguen guardando en UTC.
DISPLAY_TIMEZONE=America/Mexico_City

# ==========================================
# Leads API (POST /leads)
# ==========================================
# Token para POST /leads (cabecera X-Lead-Token o query ?token=)
LEAD_WEBHOOK_TOKEN=cambiar_por_token_lead_webhook

# ==========================================
# Odoo Enterprise (fase posterior)
# ==========================================
# Mantener false hasta conectar CRM
ODOO_ENABLED=false

ODOO_URL=https://odoo.tuempresa.com
ODOO_DB=production
ODOO_USERNAME=integrations@tuempresa.com
# Usar API Key, NO password (Odoo Enterprise lo soporta)
ODOO_API_KEY=tu_api_key_de_odoo

# Equipo de ventas por defecto (ID numérico en Odoo)
ODOO_DEFAULT_SALES_TEAM_ID=1

# Usuario por defecto al que asignar leads (ID numérico)
ODOO_DEFAULT_SALESPERSON_ID=2

# ==========================================
# Base de datos (gateway)
# ==========================================
DATABASE_URL=postgresql+asyncpg://gateway:gateway@db:5432/gateway

# ==========================================
# Scoring de leads (señal secundaria / dashboard)
# ==========================================
LEAD_CREATION_THRESHOLD=6
HUMAN_HANDOFF_THRESHOLD=9

# ==========================================
# Seguridad
# ==========================================
# Token para /admin y login del dashboard HTML
ADMIN_API_TOKEN=cambiar_por_un_token_admin_seguro

# Lista de IPs permitidas para /admin y /dashboard (separadas por coma, vacío = todas)
ADMIN_ALLOWED_IPS=

# ==========================================
# Chatwoot Agent Bot
# ==========================================
# Docs: docs/chatwoot_agent_bot.md
# false = el webhook responde 200 pero el bot no contesta
CHATWOOT_ENABLED=true
CHATWOOT_BASE_URL=https://chat.tuempresa.com
CHATWOOT_ACCOUNT_ID=1
# access_token del Agent Bot (Settings → Bots)
CHATWOOT_BOT_TOKEN=
# Opcional: secret para verificar firma del webhook del bot
CHATWOOT_WEBHOOK_SECRET=
# Junta mensajes rápidos del mismo hilo (segundos) antes de llamar al LLM
CHATWOOT_DEBOUNCE_SECONDS=4
# Fallos seguidos del agente antes de abrir el ticket (0 = nunca por error)
AGENT_ERROR_HANDOFF_THRESHOLD=3
# Obsoleto: el bot ya no vuelve a pending a los N minutos.
# Abre el ticket (open) y sigue contestando hasta que un humano escriba al cliente.
# CHATWOOT_HANDOFF_RESUME_MINUTES=
# Varios mensajes seguidos (burbujas WhatsApp) por respuesta del bot
CHATWOOT_REPLY_MAX_BUBBLES=4
CHATWOOT_REPLY_BUBBLE_DELAY_MS=700
# Pausa natural hasta el primer mensaje (el LLM cuenta). Rango 8–16 s.
CHATWOOT_REPLY_MIN_SECONDS=8
CHATWOOT_REPLY_THINK_SECONDS=1.2
CHATWOOT_REPLY_CHARS_PER_SEC=16
CHATWOOT_REPLY_MAX_DELAY_SECONDS=16

# WhatsApp Cloud API — read receipts y «escribiendo…» para el cliente.
# Chatwoot no lo hace nativo; copia los mismos valores del inbox WhatsApp en Chatwoot.
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v26.0

# ==========================================
# LLM (OpenAI Agents SDK + LiteLLM)
# ==========================================
# OpenAI → Responses API nativa (recomendado para gpt-5.* / tools).
# Anthropic → LiteLLM. Ejemplos:
#   AGENT_MODEL=openai/gpt-5.6-luna
#   AGENT_MODEL=openai/gpt-4.1-mini
#   AGENT_MODEL=anthropic/claude-sonnet-4-5
#   AGENT_MODEL=anthropic/claude-sonnet-4-20250514
# Valores iniciales; después se pueden cambiar en /dashboard/knowledge/model
# (llaves vacías en esa pantalla = se conserva la actual; «Quitar» vuelve a estos valores).
AGENT_MODEL=openai/gpt-5.6-luna
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_FAQ_CHAR_LIMIT=12000
# Embeddings (solo .env; no se editan en el dashboard)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_RETRIEVE_K=8
KNOWLEDGE_UPLOADS_DIR=knowledge_uploads
